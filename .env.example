# Backend environment variables

NODE_ENV=development
PORT=3000
FRONT_PORT=5173
MONGO_URI=mongodb://admin:adminpassword@mongo:27017/myapp?authSource=admin
SUPER_EMAIL=admin@example.com
SUPER_PASS=SuperPassword123
JWT_SECRET=super_random_key

# Optional pepper for API-key hashes (SHA-256). Empty by default; set a random
# string in production. Changing it invalidates all previously issued keys.
API_KEY_HASH_SECRET=

# Mongo DB environment variables

MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=adminpassword
MONGO_DB=myapp

# HTTPS (self-signed certs for 42 evaluation; paths only, no secrets)
SSL_KEY_PATH=certs/key.pem
SSL_CERT_PATH=certs/cert.pem
